CLASS zm_amdp_05 DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC .

  PUBLIC SECTION.
    INTERFACES if_amdp_marker_hdb .

    TYPES : tt_vbak TYPE TABLE OF zman_vbak WITH EMPTY  KEY.
    CLASS-METHODS :
      get_vbak  AMDP OPTIONS CDS SESSION CLIENT DEPENDENT READ-ONLY RETURNING VALUE(it_vbak) TYPE tt_vbak,
      get_vbak2  AMDP OPTIONS CDS SESSION CLIENT DEPENDENT EXPORTING VALUE(it_vbak1) TYPE tt_vbak.




  PROTECTED SECTION.
  PRIVATE SECTION.
ENDCLASS.



CLASS zm_amdp_05 IMPLEMENTATION.
  METHOD get_vbak BY DATABASE FUNCTION FOR HDB LANGUAGE SQLSCRIPT OPTIONS READ-ONLY USING zman_vbak.
    RETURN
    select *
    from zman_vbak;
  ENDMETHOD.
  METHOD get_vbak2 BY DATABASE PROCEDURE FOR HDB LANGUAGE SQLSCRIPT OPTIONS READ-ONLY USING zm_amdp_05=>get_vbak.
    IT_VBAK1  = SELECT * FROM "ZM_AMDP_05=>GET_VBAK"( );
  ENDMETHOD.
ENDCLASS.
